{
  "expo": {
    "name": "EntreLinhas",
    "slug": "entrelinhas",
    "owner": "137588",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-manifest.png",
    "scheme": "entrelinhas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/entrelinhas-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fbfe"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cesmac.entrelinhas",
      "icon": "./assets/images/app-icon-manifest.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-manifest.png",
        "backgroundColor": "#f8fbfe"
      },
      "package": "com.cesmac.entrelinhas",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fbfe",
          "image": "./assets/images/entrelinhas-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
