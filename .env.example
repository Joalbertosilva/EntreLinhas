# Variáveis de ambiente — tcc-sistema
# Copie para apps/web/.env.local e apps/mobile/.env após `supabase start`
# Obtenha valores reais: supabase status

# ── Web (Vite) ──
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# ── Mobile (Expo) ──
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Edge Functions (somente server-side, NUNCA no client) ──
# SUPABASE_SERVICE_ROLE_KEY=
# Definida automaticamente pelo Supabase CLI em ambiente local

# ── Docker / Supabase local ──
# PostgreSQL direto (Adminer, migrations manuais): porta 54322
# Studio: http://127.0.0.1:54323
# Adminer (docker compose --profile tools up): http://localhost:8080
